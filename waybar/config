{
  "layer": "top",
  "position": "top",

  "modules-left": ["clock", "cpu", "temperature", "backlight", "network"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["battery", "tray"],

  "clock": {
    "format": "{:%H:%M %d-%m-%Y}",
    "tooltip-format": "{:%A, %B %d, %Y | %H:%M:%S}"
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": true
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C",
    "tooltip": true
  },

  "backlight": {
    "format": " {percent}%"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " Wired",
    "format-disconnected": " Disconnected"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": ""
    }
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}

